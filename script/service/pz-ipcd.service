[Unit]
Description=PZ IPC Daemon
After=network.target postgresql.service pz-db-ready.service
Wants=postgresql.service pz-db-ready.service
PartOf=pretzel.target

[Service]
Type=simple
ExecStart=/opt/pretzel/bin/pz-ipcd

Restart=always
RestartSec=2

LimitNOFILE=1048576

# systemd's default leaves RLIMIT_CORE's SOFT limit at 0, so a crash writes nothing however
# generous the hard limit is. The core goes to kernel.core_pattern, which pz-core-handler owns.
LimitCORE=infinity

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pz-ipcd

KillSignal=SIGTERM
TimeoutStopSec=10

RuntimeDirectory=pretzel
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755

[Install]
WantedBy=pretzel.target
