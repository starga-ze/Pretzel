[Unit]
Description=PZ Topology Daemon

After=pz-ipcd.service postgresql.service pz-db-ready.service
Requires=pz-ipcd.service
Wants=postgresql.service pz-db-ready.service
PartOf=pretzel.target

[Service]
Type=simple
ExecStart=/opt/pretzel/bin/pz-topologyd

Restart=always
RestartSec=3

LimitNOFILE=65536

# systemd's default leaves RLIMIT_CORE's SOFT limit at 0, so a crash writes nothing however
# generous the hard limit is. The core goes to kernel.core_pattern, which pz-core-handler owns.
LimitCORE=infinity

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pz-topologyd

[Install]
WantedBy=pretzel.target
